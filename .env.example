# Generate a long random value: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@postgres:5432/rag_bot_db
CORS_ORIGINS=http://localhost:5173,http://localhost

# Gmail SMTP (enable Google 2-Step Verification, then create a 16-character App Password)
# Never use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-project-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-project-email@gmail.com

# Used only by the one-time bootstrap command
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator
